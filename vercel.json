{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "zm-exclusiva-admin-guilherme.vercel.app"
        }
      ],
      "destination": "https://zm-exclusiva-tau.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/admin/setup",
      "destination": "/#admin/setup",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/#admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "/#admin",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?auth_path=:path*"
    }
  ]
}
