{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "https://zm-exclusiva-admin-guilherme.vercel.app/#admin",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://zm-exclusiva-admin-guilherme.vercel.app/#admin",
      "permanent": false
    }
  ]
}
